# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node
node_modules/
dist/
.vite/
# Cache incrémental de `tsc -b`, régénéré à chaque build
*.tsbuildinfo

# Env / secrets
.env
.env.local
*.local

# Données locales : tout le dossier data/ reste hors dépôt. Il contient la
# vraie donnée métier (classeurs source, fichiers nettoyés, logs d'import,
# mapping d'IDs) qui ne doit jamais être committée. Les règles précédentes ne
# couvraient que la racine de data/ (data/*.xlsx), pas les sous-dossiers
# data/source/, data/cleaned/, data/output/ — d'où ce verrou global.
data/

# Éditeurs
.idea/
.vscode/
*.swp
.DS_Store

# Logs
*.log

# Local Claude Code config
.claude/

# Local DB dumps / exports (la stratégie backup réelle vit dans le service backup)
backups/
exports/

# Rapports ZAP générés localement — on ne versionne que la config des règles
.zap/*
!.zap/rules.tsv
