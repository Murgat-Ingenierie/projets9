# Copier en .env et adapter
POSTGRES_USER=gestion
POSTGRES_PASSWORD=changeme_en_prod
POSTGRES_DB=gestion_projet

# Connexion API → DB (interne au réseau docker)
DATABASE_URL=postgresql+psycopg://gestion:changeme_en_prod@db:5432/gestion_projet

# Secrets JWT
JWT_SECRET=changeme_avec_un_secret_long_et_aleatoire
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=60

# Admin initial créé par la seed
SEED_ADMIN_EMAIL=charles@lesfontaines.local
SEED_ADMIN_PASSWORD=changeme_au_premier_login
SEED_ADMIN_NAME=Charles Murgat

# Port d'exposition du proxy nginx
PROXY_PORT=8080

# Backup
BACKUP_RETENTION_DAYS=30
# Plancher de sécurité : on ne descend jamais sous ce nombre de sauvegardes,
# même si elles sont toutes plus vieilles que la rétention (protège d'un vidage
# du dossier après une longue panne).
BACKUP_MIN_COPIES=7

# Auth débrayée en attendant Keycloak : l'API ignore les tokens et renvoie le
# premier admin actif (le front n'a plus ni login ni guards). L'application est
# donc SANS authentification tant que Keycloak n'est pas branché — à réserver à
# un réseau de confiance, et repasser à false une fois Keycloak en place.
AUTH_DISABLED=true

# --- Keycloak (OIDC) ---
# LAISSER VIDE ICI : ce fichier est versionné (dépôt public). Les vraies valeurs
# vont dans `.env`, qui est gitignoré — ne jamais y recopier l'URL du serveur
# d'authentification ni le nom du realm.
#
# Renseigner les deux premières ACTIVE l'adossement OIDC : l'API valide alors les
# jetons du realm (RS256 via JWKS, vérification de l'émetteur et de l'audience)
# au lieu du JWT maison. Tant qu'elles sont vides, rien ne change.
# Passer AUTH_DISABLED à false le jour où l'on bascule.
#
#   KEYCLOAK_BASE_URL=https://<serveur-keycloak>
#   KEYCLOAK_REALM=<realm>
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
# Audience attendue dans le jeton, et client Keycloak qui porte les rôles
# applicatifs (`admin`, `membre`, `app-projets9-access`). Propre à cette
# application, donc sans caractère sensible.
KEYCLOAK_API_AUDIENCE=projets9-api
# Origine du serveur d'authentification (schéma + hôte, SANS chemin), injectée
# dans la CSP du proxy. Indispensable : sans elle, la CSP stricte bloque le
# navigateur qui tente de joindre Keycloak (`connect-src`), et le renouvellement
# silencieux (`frame-src`). Ex. : KEYCLOAK_ORIGIN=https://<serveur-keycloak>
KEYCLOAK_ORIGIN=

# Front (SPA). Vite inscrit ces valeurs dans le bundle AU BUILD : les changer
# impose de reconstruire l'image `web` (`docker compose up -d --build web`).
# Vides = adossement inactif, comme côté API.
#   VITE_OIDC_AUTHORITY=https://<serveur-keycloak>/realms/<realm>
#   VITE_OIDC_CLIENT_ID=projets9-front
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_API_CLIENT_ID=projets9-api

# Origines CORS autorisées (séparées par des virgules). Vide = même origine
# via le proxy, aucun CORS. Ex : CORS_ORIGINS=http://localhost:5173
# Ne jamais mettre "*".
CORS_ORIGINS=

# Si true, la seed peuple le planning avec un jeu de démonstration réaliste
# (projets, tâches, jalons, dépendances, équipes, mesures) au premier démarrage.
# Idempotent : ne s'exécute jamais par-dessus des données existantes.
# À laisser false pour une installation réelle. On peut aussi le lancer à la
# demande : docker compose exec api python -m app.seed_demo
SEED_DEMO=false
