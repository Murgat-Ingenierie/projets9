# Copier en .env et adapter
POSTGRES_USER=gestion
POSTGRES_PASSWORD=changeme_en_prod
POSTGRES_DB=gestion_projet

# Connexion API → DB (interne au réseau docker)
DATABASE_URL=postgresql+psycopg://gestion:changeme_en_prod@db:5432/gestion_projet

# Secrets JWT
JWT_SECRET=changeme_avec_un_secret_long_et_aleatoire
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=60

# Admin initial créé par la seed
SEED_ADMIN_EMAIL=charles@lesfontaines.local
SEED_ADMIN_PASSWORD=changeme_au_premier_login
SEED_ADMIN_NAME=Charles Murgat

# Port d'exposition du proxy nginx
PROXY_PORT=8080

# Backup
BACKUP_RETENTION_DAYS=30
