# Copier en .env et adapter
POSTGRES_USER=gestion
POSTGRES_PASSWORD=changeme_en_prod
POSTGRES_DB=gestion_projet

# Connexion API → DB (interne au réseau docker)
DATABASE_URL=postgresql+psycopg://gestion:changeme_en_prod@db:5432/gestion_projet

# Port d'exposition du proxy nginx
PROXY_PORT=8080

# Backup
BACKUP_RETENTION_DAYS=30
# Plancher de sécurité : on ne descend jamais sous ce nombre de sauvegardes,
# même si elles sont toutes plus vieilles que la rétention (protège d'un vidage
# du dossier après une longue panne).
BACKUP_MIN_COPIES=7

# --- Keycloak (OIDC) — OBLIGATOIRE ---
# C'est le SEUL moyen de s'authentifier : il n'y a plus ni login maison ni mode
# débrayé. L'API refuse de démarrer si les deux premières sont vides, et
# `docker compose up` s'arrête avant même de construire.
#
# LAISSER VIDE ICI : ce fichier est versionné (dépôt public). Les vraies valeurs
# vont dans `.env`, qui est gitignoré — ne jamais y recopier l'URL du serveur
# d'authentification ni le nom du realm.
#
# Le realm doit porter, pour cette application, les rôles `admin`, `membre` et
# `app-projets9-access` (sans ce dernier, un compte du realm est refusé ici).
# Ils sont lus indifféremment au niveau realm ou client — voir api/app/auth/oidc.py.
#
#   KEYCLOAK_BASE_URL=https://<serveur-keycloak>
#   KEYCLOAK_REALM=<realm>
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
# Audience attendue dans le jeton, et client Keycloak qui porte les rôles
# applicatifs (`admin`, `membre`, `app-projets9-access`). Propre à cette
# application, donc sans caractère sensible.
KEYCLOAK_API_AUDIENCE=projets9-api
# Origine du serveur d'authentification (schéma + hôte, SANS chemin), injectée
# dans la CSP du proxy. Indispensable : sans elle, la CSP stricte bloque le
# navigateur qui tente de joindre Keycloak (`connect-src`), et le renouvellement
# silencieux (`frame-src`). Ex. : KEYCLOAK_ORIGIN=https://<serveur-keycloak>
KEYCLOAK_ORIGIN=

# Front (SPA) — OBLIGATOIRE aussi. Vite inscrit ces valeurs dans le bundle AU
# BUILD : les changer impose de reconstruire l'image `web`
# (`docker compose up -d --build web`). Les renseigner dans .env puis se
# contenter de redémarrer le conteneur ne produit AUCUN effet — piège classique.
#   VITE_OIDC_AUTHORITY=https://<serveur-keycloak>/realms/<realm>
#   VITE_OIDC_CLIENT_ID=projets9-front
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_API_CLIENT_ID=projets9-api

# Origines CORS autorisées (séparées par des virgules). Vide = même origine
# via le proxy, aucun CORS. Ex : CORS_ORIGINS=http://localhost:5173
# Ne jamais mettre "*".
CORS_ORIGINS=

# Plafond de comptes ACTIFS (INV-AUTH-2, SPEC §5 : ≤ 10 par défaut).
#
# Ce que « actif » recouvre, et qui surprend : un compte créé à l'avance (import
# du classeur, ajout manuel) est actif dès sa création, avant toute connexion. Il
# occupe donc une place. Et comme Keycloak provisionne à la première connexion,
# quelqu'un dont l'adresse du realm diffère de celle du compte préparé se voit
# créer un SECOND compte — deux places pour une personne.
#
# Au-delà du plafond, la connexion est refusée par un 403 que l'utilisateur lit
# « Connexion impossible » : rien ne lui indique qu'il s'agit d'une capacité.
# Deux leviers : désactiver les comptes inutilisés (écran Utilisateurs), ou
# relever cette valeur.
MAX_ACTIVE_USERS=10

# Si true, la seed peuple le planning avec un jeu de démonstration réaliste
# (projets, tâches, jalons, dépendances, équipes, mesures) au premier démarrage.
# Idempotent : ne s'exécute jamais par-dessus des données existantes.
# À laisser false pour une installation réelle.
#
# Exige un administrateur en base, à qui rattacher les données — et il n'y en a
# aucun tant que personne ne s'est connecté, puisque c'est Keycloak qui
# provisionne. Sur une installation neuve, la démo est donc ignorée au premier
# démarrage : se connecter une fois, puis relancer à la demande —
#   docker compose exec api python -m app.seed_demo
SEED_DEMO=false
