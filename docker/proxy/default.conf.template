# CSP calculée selon l'URL : stricte partout (script-src 'self'), assouplie
# uniquement pour Swagger UI / ReDoc, qui chargent leurs assets depuis jsdelivr
# et exécutent un script d'init inline. On passe par une variable (map) pour
# n'avoir qu'UN SEUL jeu d'add_header au niveau serveur — pas de redéfinition
# par location (nginx remplace au lieu de fusionner, un vrai footgun).
#
# ${KEYCLOAK_ORIGIN} est substitué AU DÉMARRAGE du conteneur (templates nginx +
# envsubst), pas écrit ici : l'URL du serveur d'authentification n'a rien à faire
# dans un dépôt. Vide = aucune origine externe autorisée, la CSP reste stricte.
#
# Deux directives sont nécessaires, et pour deux raisons distinctes :
#   - connect-src : oidc-client-ts lit le document de découverte et échange le
#     code contre un jeton, en fetch() ;
#   - frame-src   : le renouvellement silencieux passe par une iframe cachée
#     pointant sur Keycloak. Sans elle, la session expire au bout d'une heure
#     et l'utilisateur est renvoyé sur l'écran de connexion.
# `default-src 'self'` ne les couvre PAS pour une origine externe — d'où leur
# déclaration explicite.
map $uri $csp_policy {
    default            "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' ${KEYCLOAK_ORIGIN}; frame-src ${KEYCLOAK_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${KEYCLOAK_ORIGIN}";
    "~^/api/(docs|redoc)$" "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'";
}

server {
    listen 80;
    server_name _;
    client_max_body_size 16M;

    # Ne pas divulguer la version de nginx dans l'en-tête Server.
    server_tokens off;

    # Résolution DNS des conteneurs, réévaluée en continu.
    #
    # Un bloc `upstream { server api:8000; }` — ce qu'il y avait ici — résout le
    # nom UNE SEULE FOIS, au chargement de la configuration, et garde l'adresse
    # indéfiniment. Or Docker en réattribue une autre à la recréation d'un
    # conteneur : après un `--no-cache` ou un simple redéploiement de l'API, le
    # proxy continuait de parler à une adresse qui n'était plus la sienne et
    # répondait 502 jusqu'à ce qu'on le redémarre LUI. Reproduit avant d'écrire
    # cette correction : api déplacée de .4 à .7, nginx toujours sur .4.
    #
    # 127.0.0.11 est le résolveur interne de Docker, présent dans tout conteneur
    # d'un réseau utilisateur. `valid=10s` borne la mise en cache — dix secondes
    # au pire, contre indéfiniment. `ipv6=off` parce que le résolveur peut
    # renvoyer une AAAA que rien n'écoute, et nginx tenterait celle-là d'abord.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Les cibles passent par des VARIABLES : c'est la condition pour que nginx
    # diffère la résolution au lieu de la figer au démarrage. Une cible écrite en
    # dur serait de nouveau résolue une fois pour toutes.
    #
    # Aucune n'inclut de chemin, volontairement : nginx transmet alors l'URI
    # d'origine telle quelle, comme le faisaient les blocs remplacés. En ajouter
    # un REMPLACERAIT l'URI de la requête — `/api/health` deviendrait `/`.
    set $cible_api http://api:8000;
    set $cible_web http://web:80;

    # En-têtes de sécurité, définis UNE fois ici et hérités par les locations
    # (aucune n'a d'add_header propre). La CSP varie via $csp_policy ci-dessus.
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;
    add_header Content-Security-Policy $csp_policy always;

    location /api/ {
        proxy_pass $cible_api;
        # Host client transmis aux upstreams internes (api, web) qui ne s'en
        # servent pour aucune décision de sécurité (pas de génération d'URL
        # absolue, pas de cache par Host). Injection de Host non applicable ici.
        # nosemgrep: generic.nginx.security.request-host-used.request-host-used
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass $cible_web;
        # nosemgrep: generic.nginx.security.request-host-used.request-host-used
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
